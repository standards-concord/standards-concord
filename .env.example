# Copy to .env and fill in what you have. Everything is optional: with nothing set,
# Concord runs fully offline with a simulated AI, local storage and demo sign-in.

PORT=8787
PUBLIC_URL=http://localhost:8787
# Where the web app is served from (OAuth redirects back here). Same as PUBLIC_URL in production.
WEB_URL=http://localhost:5173
SESSION_SECRET=change-me
# Shared with the Vercel middleware (same variable there). The backend only trusts the forwarded
# domain and visitor IP from requests carrying it. Generate with: openssl rand -hex 32
CONCORD_PROXY_SECRET=
# Extra comma-separated origins that may appear in OAuth metadata when the backend is reached directly.
PUBLIC_ORIGINS=
# Demo mode: persona sign-in, the simulated working group and the governance clock controls.
DEMO_MODE=true
# Comma-separated emails (Google or GitHub sign-in) that can reset the demo and read all feedback.
ADMIN_EMAILS=

# AI (Claude). Without a key, every AI step uses a deterministic offline fallback.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=high
# Most Concord may spend on Claude per UTC day and month (US dollars, estimated from token usage). When a limit
# is reached, AI features use their offline stand-ins until it resets. 0 turns real AI calls off.
LLM_DAILY_BUDGET_USD=5
LLM_MONTHLY_BUDGET_USD=40

# Sign in with Google (OAuth client, redirect URI ${PUBLIC_URL}/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign in with GitHub (OAuth app, callback ${PUBLIC_URL}/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Publish released ontologies to GitHub (token with repo scope)
GITHUB_PUBLISH_TOKEN=
GITHUB_PUBLISH_OWNER=theodi
# Connect apps for app checks through the Concord GitHub App (docs/github-app.md). All six, or it's off.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Private data (interview transcripts, feedback) in Solid pods. Community Solid Server v7+.
SOLID_SERVER_URL=

# Google Meet co-facilitator bot via Recall.ai
RECALL_API_KEY=
RECALL_REGION=us-west-2
MEET_BOT_NAME=Concord co-facilitator

# Server-side speech-to-text for browsers without the Web Speech API (Firefox)
STT_PROVIDER=
OPENAI_API_KEY=
