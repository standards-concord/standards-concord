{
  "version": 3,
  "routes": [
    {
      "src": "^/(api(/.*)?|auth/.*|mcp(/.*)?|people/.*|def(/.*)?|healthz|\\.well-known/.*|authorize|token|register|revoke)$",
      "dest": "/api"
    },
    {
      "src": "^/assets/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/avatars/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/.*$",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "17 4 * * *"
    }
  ]
}