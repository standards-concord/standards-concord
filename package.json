{
  "name": "concord",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "dev": "pnpm --parallel -r dev",
    "start": "pnpm --filter @concord/server start",
    "test:e2e": "playwright test -c e2e --project=local",
    "test:e2e:smoke": "playwright test -c e2e --project=local app.spec alpha.spec reasoner.spec validate.spec",
    "test:e2e:live": "playwright test -c e2e --project=live",
    "test:e2e:solid": "playwright test -c e2e/solid.config.ts",
    "walkthrough": "pnpm --filter @concord/walkthrough record",
    "avatars": "node scripts/generate-avatars.mjs",
    "samples:convert": "pnpm --filter @concord/core exec node --import tsx ../../scripts/samples/convert-samples.ts"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@dicebear/core": "9.4.2",
    "@dicebear/notionists": "9.4.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "1.63.0",
    "@vercel/functions": "3.10.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "ts-morph": "28.0.0"
  }
}
