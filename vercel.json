{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @concord/web build",
  "outputDirectory": "apps/web/dist",
  "git": { "deploymentEnabled": { "**": false, "main": true } },
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "rewrites": [{ "source": "/((?!api/|auth/|mcp|people/|def/|healthz|assets/|avatars/|\\.well-known/|authorize|token|register|revoke).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/avatars/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
