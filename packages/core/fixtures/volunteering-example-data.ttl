# Example instance data for the Volunteering Ontology, used by the competency questions.
# All data is fictional.
@prefix vol: <https://w3id.org/odi/volunteering#> .
@prefix ex: <https://example.org/volunteering-data/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:greenSpacesTrust a vol:VolunteerInvolvingOrganisation , vol:Organisation ;
    rdfs:label "Green Spaces Trust" ;
    vol:charityNumber "1234567" ;
    vol:offersOpportunity ex:parkCleanUp .

ex:befrienders a vol:VolunteerInvolvingOrganisation , vol:Organisation ;
    rdfs:label "Neighbourhood Befrienders" ;
    vol:offersOpportunity ex:telephoneBefriending .

ex:environment a vol:Cause ; rdfs:label "Environment and conservation" .
ex:socialCare a vol:Cause ; rdfs:label "Health and social care" .

ex:firstAid a vol:Skill ; rdfs:label "First aid" .
ex:listening a vol:Skill ; rdfs:label "Active listening" .

ex:parkCleanUp a vol:VolunteeringOpportunity ;
    vol:title "Saturday park clean-up" ;
    vol:summary "Help keep Victoria Park clean and safe for wildlife." ;
    vol:minimumAge "16"^^xsd:nonNegativeInteger ;
    vol:offeredBy ex:greenSpacesTrust ;
    vol:supportsCause ex:environment ;
    vol:hasRole ex:litterPicker , ex:teamLeader ;
    vol:hasLocation ex:victoriaPark ;
    vol:hasSession ex:parkSession1 .

ex:telephoneBefriending a vol:VolunteeringOpportunity ;
    vol:title "Telephone befriending" ;
    vol:summary "Weekly phone calls with an older person who lives alone." ;
    vol:minimumAge "18"^^xsd:nonNegativeInteger ;
    vol:offeredBy ex:befrienders ;
    vol:supportsCause ex:socialCare ;
    vol:hasRole ex:befriender ;
    vol:hasLocation ex:phoneLine ;
    vol:hasSession ex:callSession1 .

ex:litterPicker a vol:Role ; rdfs:label "Litter picker" ; vol:requiresBackgroundCheck false .
ex:teamLeader a vol:Role ; rdfs:label "Team leader" ; vol:requiresSkill ex:firstAid ; vol:requiresBackgroundCheck false .
ex:befriender a vol:Role ; rdfs:label "Befriender" ; vol:requiresSkill ex:listening ;
    vol:requiresBackgroundCheck true ; vol:hasTimeCommitment ex:oneHourWeekly .

ex:oneHourWeekly a vol:TimeCommitment ; vol:hoursPerWeek 1.0 .

ex:victoriaPark a vol:PhysicalLocation ; rdfs:label "Victoria Park" ; vol:postcode "E9 7BT" .
ex:phoneLine a vol:OnlineLocation ; rdfs:label "Telephone / video call" ;
    vol:joiningUrl "https://meet.example.org/befriending"^^xsd:anyURI .

ex:parkSession1 a vol:Session ;
    vol:startDateTime "2026-11-07T10:00:00Z"^^xsd:dateTime ;
    vol:endDateTime "2026-11-07T13:00:00Z"^^xsd:dateTime ;
    vol:placesAvailable "12"^^xsd:nonNegativeInteger ;
    vol:hasLocation ex:victoriaPark .

ex:callSession1 a vol:Session ;
    vol:startDateTime "2026-11-03T18:00:00Z"^^xsd:dateTime ;
    vol:endDateTime "2026-11-03T19:00:00Z"^^xsd:dateTime ;
    vol:placesAvailable "3"^^xsd:nonNegativeInteger ;
    vol:hasLocation ex:phoneLine .

ex:sam a vol:Volunteer , vol:Person ; rdfs:label "Sam" ; vol:hasSkill ex:firstAid .
ex:priya a vol:Volunteer , vol:Person ; rdfs:label "Priya" ; vol:hasSkill ex:listening .

ex:application1 a vol:Application ;
    vol:submittedBy ex:sam ;
    vol:forOpportunity ex:parkCleanUp ;
    vol:submittedAt "2026-10-01T09:30:00Z"^^xsd:dateTime .
