The name and trademarks of copyright holders may NOT be used in advertising or publicity pertaining to the work without specific, written prior permission. Title to copyright in this work will at all times remain with copyright holders.
""" ,
        "Full licence notice: /licences/W3C-20150513. Bundled copy: /docs/licences/W3C-20150513.md." ,
        "Original vocabulary published by W3C." ,
        "This document includes material copied from or derived from Meeting Ontology (http://www.w3.org/ns/pim/meeting). Copyright (c) 2016 W3C® (MIT, ERCIM, Keio, Beihang)." ;
    vann:preferredNamespacePrefix "meeting" ;
    vann:preferredNamespaceUri meeting: ;
    prov:wasDerivedFrom <http://www.w3.org/ns/pim/meeting> .

#################################################################
### Classes
#################################################################

meeting:Meeting a owl:Class ;
    rdfs:label "meeting"@en ;
    meeting:label "meeting"@en , "reunion"@fr .

meeting:VideoCallPage a owl:Class ;
    rdfs:label "video call page"@en ;
    rdfs:comment """A web page (eg on appear.in, or wherever) for  a live video chat.
    The URI should be as accurate as possible ideally without requiring meeting numbers, room numbers, etc to be entered.""" .

<http://www.w3.org/ns/pim/trip#Trip> a owl:Class .

#################################################################
### Object properties
#################################################################

meeting:trip a owl:ObjectProperty ;
    rdfs:label "trip" ;
    rdfs:range <http://www.w3.org/ns/pim/trip#Trip> .

#################################################################
### Annotation properties
#################################################################

dc:created a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:rights a owl:AnnotationProperty .

dcterms:source a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

rdfs:comment a owl:AnnotationProperty .

rdfs:isDefinedBy a owl:AnnotationProperty .

rdfs:label a owl:AnnotationProperty .

rdfs:seeAlso a owl:AnnotationProperty .

meeting:actionItems a owl:AnnotationProperty ;
    rdfs:label "action items" .

meeting:agenda a owl:AnnotationProperty ;
    rdfs:label "agenda" .

meeting:attendeeGroup a owl:AnnotationProperty ;
    rdfs:label "attendees"@en , "participants"@fr .

meeting:chat a owl:AnnotationProperty ;
    rdfs:label "chat" ;
    rdfs:comment "A live text-based chat object or chat document." .

meeting:label a owl:AnnotationProperty .

meeting:nextMeeting a owl:AnnotationProperty ;
    rdfs:label "next meeting" .

meeting:previousMeeting a owl:AnnotationProperty ;
    rdfs:label "previous meeting" .

meeting:sharedNotes a owl:AnnotationProperty ;
    rdfs:label "notes"@en , "notes"@fr ;
    rdfs:comment "A shared notepad to capture the course and result of the meeting" .

meeting:toolList a owl:AnnotationProperty .

meeting:videoCallPage a owl:AnnotationProperty ;
    rdfs:label "video call"@en ;
    rdfs:comment """For a meeting, a web page (eg on appear.in, or wherever) for  a live video chat for the meeting.
  The URI should be as accurate as possible ideally without requiring meeting numbers etc to be entered.""" .

prov:wasDerivedFrom a owl:AnnotationProperty .
