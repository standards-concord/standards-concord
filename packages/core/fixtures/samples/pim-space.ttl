        "This document includes material copied from or derived from Workspace Ontology (http://www.w3.org/ns/pim/space). Copyright (c) W3C® (MIT, ERCIM, Keio, Beihang)." ;
    vann:preferredNamespacePrefix "space" ;
    vann:preferredNamespaceUri space: ;
    <http://www.w3.org/2000/10/swap/pim/doc#version> "2021-10-01 18:47:19" ;
    prov:wasDerivedFrom <http://www.w3.org/ns/pim/space> .

#################################################################
### Classes
#################################################################

<http://www.w3.org/2006/gen/ont#InformationResource> a owl:Class .

space:ConfigurationFile a owl:Class ;
    rdfs:label "ConfigurationFile"@en ;
    rdfs:subClassOf <http://www.w3.org/2006/gen/ont#InformationResource> .

space:ControlledStorage a owl:Class ;
    rdfs:label "access controlled storage" ;
    rdfs:comment """A  storage is a space of URIs in which you can individually control for each resource
    who has access to it.
""" ;
    rdfs:subClassOf space:Storage .

space:MasterWorkspace a owl:Class ;
    rdfs:label "Master Workspace"@en ;
    rdfs:comment """This is a workspace for storing the
    information about the other workspaces.
    As a user, you normally don't have to worry about it.""" ;
    rdfs:subClassOf space:PrivateWorkspace .

space:PersonalStorage a owl:Class ;
    rdfs:label "personal storage" ;
    rdfs:comment """A personal storage is a space of URIs in which you and only you have access to data,
    you cannot give access to anyone else.
""" ;
    rdfs:subClassOf space:Storage .

space:PreferencesWorkspace a owl:Class ;
    rdfs:label "Preferences workspace" ;
    rdfs:comment "Aceess may not be open to the public. Contains preferences resources." ;
    rdfs:subClassOf space:Workspace .

space:PrivateWorkspace a owl:Class ;
    rdfs:label "Private workspace" ;
    rdfs:comment "Access only by the you, the user." ;
    rdfs:subClassOf space:Workspace .

space:PublicStorage a owl:Class ;
    rdfs:label "public storage" ;
    rdfs:comment """A public storage is a space of URIs in which you have access to data,
    and all data is accessible to anyone without control.
""" ;
    rdfs:subClassOf space:Storage .

space:PublicWorkspace a owl:Class ;
    rdfs:label "Public workspace" ;
    rdfs:comment """Aceess is open to the public. Anything in a public workspace
    can be accesed by anyone.""" ;
    rdfs:subClassOf space:Workspace .

space:SharedWorkspace a owl:Class ;
    rdfs:label "Shared workspace" ;
    rdfs:comment "Access is to some but not all people." ;
    rdfs:subClassOf space:Workspace .

space:Storage a owl:Class ;
    rdfs:label "storage" ;
    rdfs:comment """A storage is a space of URIs in which you have access to data.
""" .

space:Workspace a owl:Class ;
    rdfs:label "workspace" ;
    rdfs:comment """Workspaces are place where data is stored, and associated polices of privacy.
A given application typically stores information in several different
workspaces, some being user private, some shared, and some public.
""" ;
    owl:disjointUnionOf ( space:PrivateWorkspace space:SharedWorkspace space:PublicWorkspace ) .

foaf:Agent a owl:Class .

#################################################################
### Object properties
#################################################################

space:masterWorkspace a owl:ObjectProperty ;
    rdfs:label "master workspace"@en ;
    rdfs:domain foaf:Agent ;
    rdfs:range space:MasterWorkspace .

space:preferencesFile a owl:ObjectProperty ;
    rdfs:label "preferences file" ;
    rdfs:domain foaf:Agent ;
    rdfs:range space:ConfigurationFile .

space:storage a owl:ObjectProperty ;
    rdfs:label "storage" ;
    rdfs:comment """The storage in which this workspace is, or the storage which
contains this resource, or a storage available to this agent to use.""" ;
    rdfs:range space:Storage .

space:workspace a owl:ObjectProperty ;
    rdfs:label "workspace"@en ;
    rdfs:range space:Workspace .

#################################################################
### Datatype properties
#################################################################

space:uriPrefix a owl:DatatypeProperty ;
    rdfs:label "URI prefix" ;
    rdfs:comment """URIs which start with this string are in this workspace or storage.
This may be used for constructing URIs for new storage resources.
""" ;
    <http://www.w3.org/ns/ui#prompt> "Give the first part of the URis in this workspace" .

#################################################################
### Annotation properties
#################################################################

dc:title a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:rights a owl:AnnotationProperty .

dcterms:source a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

rdfs:comment a owl:AnnotationProperty .

rdfs:isDefinedBy a owl:AnnotationProperty .

rdfs:label a owl:AnnotationProperty .

rdfs:seeAlso a owl:AnnotationProperty .

<http://www.w3.org/2000/10/swap/pim/doc#version> a owl:AnnotationProperty .

prov:wasDerivedFrom a owl:AnnotationProperty .

<http://www.w3.org/ns/ui#prompt> a owl:AnnotationProperty .
