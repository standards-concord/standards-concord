# Concord sample copy for trying Concord: Solid Terms
# Source: http://www.w3.org/ns/solid/terms
# Publisher: Solid Project
# Licence: CC0 1.0 <https://creativecommons.org/publicdomain/zero/1.0/>
# Upstream copy: upstream/solid-terms.ttl (see upstream/SOURCES.md)
# Changes: Added an ontology header, explicit OWL declarations and declarations for referenced terms. Kept term IRIs, namespaces, labels and comments. Unconstrained or mixed-use properties are annotations; class and property metadata has no metamodel domain or range. Removed reserved RDF/RDFS metamodel constraints. Unsupported datatype ranges are widened to rdfs:Literal; annotation dates keep their lexical values as strings. Resolved rdf:Property declarations from their ranges and usage. Named anonymous provenance records with stable URNs.

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix solid: <http://www.w3.org/ns/solid/terms#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
### Ontology
#################################################################

<http://www.w3.org/ns/solid/terms> a owl:Ontology ;
    owl:versionInfo <urn:concord:sample:solid:metadata-1> ;
    dcterms:title "Solid Terms"@en ;
    dcterms:description "Settings and links that help Solid apps find profiles, preferences and storage."@en ;
    rdfs:label "Solid Terms"@en ;
    rdfs:comment "Concord sample copy for trying Concord. Added an ontology header, explicit OWL declarations and declarations for referenced terms. Kept term IRIs, namespaces, labels and comments. Unconstrained or mixed-use properties are annotations; class and property metadata has no metamodel domain or range. Removed reserved RDF/RDFS metamodel constraints. Unsupported datatype ranges are widened to rdfs:Literal; annotation dates keep their lexical values as strings. Resolved rdf:Property declarations from their ranges and usage. Named anonymous provenance records with stable URNs."@en ,
        "The Solid Terms vocabulary defines terms referenced in Solid specifications."@en ;
    dcterms:source <http://www.w3.org/ns/solid/terms> ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2015-11-16" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:rights "Original vocabulary published by Solid Project." ;
    vann:preferredNamespacePrefix "solid" ;
    vann:preferredNamespaceUri "http://www.w3.org/ns/solid/terms#"^^xsd:anyURI , solid: ;
    prov:wasDerivedFrom <http://www.w3.org/ns/solid/terms> .

#################################################################
### Classes
#################################################################

<http://rdfs.org/sioc/ns#Post> a owl:Class .

<http://www.w3.org/2000/10/swap/log#Formula> a owl:Class .

solid:Account a owl:Class ;
    rdfs:label "Account"@en ;
    rdfs:comment "A Solid account."@en ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2016-05-17" .

solid:Inbox a owl:Class ;
    rdfs:label "Inbox"@en ;
    rdfs:comment "A resource containing notifications."@en ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2015-11-16" ;
    dcterms:modified "2018-10-24" .

solid:InsertDeletePatch a owl:Class ;
    rdfs:label "Insert/delete patch"@en ;
    rdfs:comment "A class of patch expressing insertions, deletions, and conditional modifications to a resource that has an RDF-based representation."@en ;
    rdfs:subClassOf solid:Patch ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2022-05-03" ;
    rdfs:seeAlso <https://solidproject.org/TR/2021/protocol-20211217#server-patch-n3-type> .

solid:ListedDocument a owl:Class ;
    rdfs:label "Listed Type Index"@en ;
    rdfs:comment "Listed Type Index is a registry of resources that are publicly discoverable by outside users and applications."@en ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2015-11-16" ;
    dcterms:modified "2018-01-24" .

solid:Notification a owl:Class ;
    rdfs:label "Notification"@en ;
    rdfs:comment "A notification resource."@en ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2015-12-18" ;
    dcterms:modified "2015-12-20" , "2018-10-25" .

solid:Patch a owl:Class ;
    rdfs:label "Patch"@en ;
    rdfs:comment "A patch expresses conditional modifications to a resource that has an RDF-based representation."@en ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2017-08-17" .

solid:Timeline a owl:Class ;
    rdfs:label "Timeline"@en ;
    rdfs:comment "A resource containing time ordered items and sub-containers.  Sub-containers may be desirable in file based systems to split the timeline into logical components e.g. /yyyy-mm-dd/ as used in ISO 8061."@en ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2016-01-04" .

solid:TypeIndex a owl:Class ;
    rdfs:label "Type index"@en ;
    rdfs:comment "A index of type registries for resources. Applications can register the RDF type they use and list them in the index resource."@en ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2016-02-05" .

solid:TypeRegistration a owl:Class ;
    rdfs:label "Type Registration"@en ;
    rdfs:comment "The registered types that map a RDF classes/types to their locations using either `instance` or `instanceContainer` property."@en ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2018-01-24" .

solid:UnlistedDocument a owl:Class ;
    rdfs:label "Unlisted Type Index"@en ;
    rdfs:comment "Unlisted Type Index is a registry of resources that are private to the user and their apps, for types that are not publicly discoverable."@en ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2018-01-24" .

foaf:Agent a owl:Class .

#################################################################
### Object properties
#################################################################

solid:deletes a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "deletes"@en ;
    rdfs:comment "The triple patterns this patch removes from the document."@en ;
    rdfs:domain solid:Patch ;
    rdfs:range <http://www.w3.org/2000/10/swap/log#Formula> ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2017-08-17" .

solid:inserts a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "inserts"@en ;
    rdfs:comment "The triple patterns this patch adds to the document."@en ;
    rdfs:domain solid:Patch ;
    rdfs:range <http://www.w3.org/2000/10/swap/log#Formula> ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2017-08-17" .

solid:owner a owl:ObjectProperty ;
    rdfs:label "owner"@en ;
    rdfs:comment "A person or social entity that is considered to have control, rights, and responsibilities over a data storage."@en ;
    rdfs:range foaf:Agent ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2021-05-19" .

solid:patches a owl:ObjectProperty ;
    rdfs:label "patches"@en ;
    rdfs:comment "The document to which this patch applies."@en ;
    rdfs:domain solid:Patch ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2017-08-17" .

solid:privateLabelIndex a owl:ObjectProperty ;
    rdfs:label "private label index"@en ;
    rdfs:comment "Points to an unlisted label index resource."@en ;
    rdfs:range solid:UnlistedDocument ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2023-10-04" .

solid:privateTypeIndex a owl:ObjectProperty ;
    rdfs:label "private type index"@en ;
    rdfs:comment "Points to an unlisted type index resource."@en ;
    rdfs:range solid:UnlistedDocument ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2018-01-24" .

solid:publicTypeIndex a owl:ObjectProperty ;
    rdfs:label "public type index"@en ;
    rdfs:comment "Points to a listed type index resource."@en ;
    rdfs:subPropertyOf solid:typeIndex ;
    rdfs:range solid:ListedDocument ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2018-01-24" .

solid:storageDescription a owl:ObjectProperty ;
    rdfs:label "storage description"@en ;
    rdfs:comment "Refers to the resource that provides a description of the storage containing this resource."@en ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2024-12-28" ;
    rdfs:seeAlso <https://solidproject.org/TR/2024/protocol-20240512#server-storage-description> .

solid:typeIndex a owl:ObjectProperty ;
    rdfs:label "type index"@en ;
    rdfs:comment "Points to a TypeIndex resource."@en ;
    rdfs:range solid:TypeIndex ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2016-02-05" .

solid:where a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "where"@en ;
    rdfs:comment "The conditions the document and the inserted and deleted triple patterns need to satisfy in order for the patch to be applied."@en ;
    rdfs:domain solid:Patch ;
    rdfs:range <http://www.w3.org/2000/10/swap/log#Formula> ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2017-08-17" .

#################################################################
### Datatype properties
#################################################################

solid:storageQuota a owl:DatatypeProperty ;
    rdfs:label "Non-volatile memory quota"@en ;
    rdfs:comment "The quota of non-volatile memory that is available for the account (in bytes)"@en ;
    rdfs:domain solid:Account ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2018-10-26" ;
    dcterms:modified "2018-11-07" , "2019-01-22" .

solid:storageUsage a owl:DatatypeProperty ;
    rdfs:label "Non-volatile memory usage"@en ;
    rdfs:comment "The amount of non-volatile memory that the account have used (in bytes)"@en ;
    rdfs:domain solid:Account ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2019-01-22" .

#################################################################
### Annotation properties
#################################################################

<http://openid.net/specs/connect/1.0/issuer> a owl:AnnotationProperty .

dcterms:date a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:replaces a owl:AnnotationProperty .

dcterms:rights a owl:AnnotationProperty .

dcterms:source a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

rdfs:comment a owl:AnnotationProperty .

rdfs:isDefinedBy a owl:AnnotationProperty .

rdfs:label a owl:AnnotationProperty .

rdfs:seeAlso a owl:AnnotationProperty .

<http://www.w3.org/ns/ldp#inbox> a owl:AnnotationProperty .

prov:wasDerivedFrom a owl:AnnotationProperty .

solid:account a owl:AnnotationProperty ;
    rdfs:label "account"@en ;
    rdfs:comment "A solid account belonging to an Agent."@en ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2016-05-17" ;
    dcterms:modified "2018-01-24" .

solid:forClass a owl:AnnotationProperty ;
    rdfs:label "registry class"@en ;
    rdfs:comment "A class that is used to map an listed or unlisted type index."@en ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2018-01-24" .

solid:inbox a owl:AnnotationProperty ;
    rdfs:label "inbox (deprecated)"@en ;
    rdfs:comment "Deprecated pointer to a Linked Data Notifications inbox; please use http://www.w3.org/ns/ldp#inbox instead."@en ;
    owl:deprecated true ;
    rdfs:subPropertyOf <http://www.w3.org/ns/ldp#inbox> ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2015-11-16" ;
    dcterms:modified "2016-02-05" , "2018-10-25" .

solid:instance a owl:AnnotationProperty ;
    rdfs:label "instance"@en ;
    rdfs:comment "Maps a type to an individual resource, typically an index or a directory listing resource."@en ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2018-01-24" .

solid:instanceContainer a owl:AnnotationProperty ;
    rdfs:label "instance container"@en ;
    rdfs:comment "Maps a type to a container which the client would have to list to get the instances of that type."@en ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2018-01-24" .

solid:loginEndpoint a owl:AnnotationProperty ;
    rdfs:label "loginEndpoint"@en ;
    rdfs:comment "The login URI of a given server."@en ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2015-11-16" .

solid:logoutEndpoint a owl:AnnotationProperty ;
    rdfs:label "logoutEndpoint"@en ;
    rdfs:comment "The logout URI of a given server."@en ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2015-11-16" .

solid:notification a owl:AnnotationProperty ;
    rdfs:label "notification"@en ;
    rdfs:comment "Notification resource for an inbox."@en ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2016-03-11" ;
    dcterms:modified "2018-10-25" .

solid:oidcIssuer a owl:AnnotationProperty ;
    rdfs:label "OIDC issuer"@en ;
    rdfs:comment "The preferred OpenID Connect issuer URI for a given WebID."@en ;
    rdfs:subPropertyOf <http://openid.net/specs/connect/1.0/issuer> ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2017-08-15" ;
    dcterms:modified "2017-08-16" .

solid:read a owl:AnnotationProperty ;
    rdfs:label "read"@en ;
    rdfs:comment "Indicates if a message has been read or not. This property should have a boolean datatype."@en ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2015-12-18" .

solid:timeline a owl:AnnotationProperty ;
    rdfs:label "timeline"@en ;
    rdfs:comment "Timeline for a given resource."@en ;
    rdfs:isDefinedBy solid: ;
    dcterms:issued "2016-01-04" .

#################################################################
### Individuals
#################################################################

solid: a owl:NamedIndividual .

#################################################################
### Other
#################################################################

<urn:concord:sample:solid:metadata-1> dcterms:date "2020-12-22" ;
    dcterms:replaces <https://raw.githubusercontent.com/solid/vocab/46a5e2a8df1df48cd21a6ecdd422a37d29d39cbe/solid-terms.ttl> ;
    rdfs:seeAlso <https://github.com/solid/vocab/pull/67> .
