@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sched: <http://www.w3.org/ns/pim/schedule#> .
@prefix vann: <http://purl.org/vocab/vann/> .

#################################################################
### Ontology
#################################################################

<http://www.w3.org/ns/pim/schedule> a owl:Ontology ;
    dcterms:title "Schedule"@en ;
    dcterms:description "Polls for finding a time that suits everyone, and how well each option suits each person."@en ;
    rdfs:comment "Concord sample copy for trying Concord. Added an ontology header, explicit OWL declarations and declarations for referenced terms. Kept term IRIs, namespaces, labels and comments. Unconstrained or mixed-use properties are annotations; class and property metadata has no metamodel domain or range. Removed reserved RDF/RDFS metamodel constraints. Unsupported datatype ranges are widened to rdfs:Literal; annotation dates keep their lexical values as strings. Promoted RDFS classes and properties to OWL declarations."@en ;
    dcterms:source <http://www.w3.org/ns/pim/schedule> ;
    dcterms:license <https://www.w3.org/Consortium/Legal/2015/copyright-software-and-document> ;
    dcterms:rights """# W3C Software and Document Notice and License (2015-05-13)

Source: <https://www.w3.org/Consortium/Legal/2015/copyright-software-and-document>. Text as recorded by SPDX (identifier `W3C-20150513`, spdx-license-list 6.12.0).

This work is being provided by the copyright holders under the following license.

