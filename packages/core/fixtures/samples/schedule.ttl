The name and trademarks of copyright holders may NOT be used in advertising or publicity pertaining to the work without specific, written prior permission. Title to copyright in this work will at all times remain with copyright holders.
""" ,
        "Full licence notice: /licences/W3C-20150513. Bundled copy: /docs/licences/W3C-20150513.md." ,
        "Original vocabulary published by W3C." ,
        "This document includes material copied from or derived from Schedule Ontology (http://www.w3.org/ns/pim/schedule). Copyright (c) W3C® (MIT, ERCIM, Keio, Beihang)." ;
    vann:preferredNamespacePrefix "sched" ;
    vann:preferredNamespaceUri sched: ;
    prov:wasDerivedFrom <http://www.w3.org/ns/pim/schedule> .

#################################################################
### Classes
#################################################################

sched:DegreesOfDifficulty a owl:Class ;
    rdfs:label "Degrees of difficulty" ;
    rdfs:comment """Provides users of a poll with a way to reflect the difficulty, pain
    or disruption which would be involved in a given choice.""" .

sched:Difficult a owl:Class ;
    rdfs:label "difficult" ;
    rdfs:comment "I would rather a different choice." ;
    sched:pain 2 ;
    <http://www.w3.org/ns/ui#backgroundColor> "#efe" .

sched:Ideal a owl:Class ;
    rdfs:label "ideal" ;
    rdfs:comment "This would be perfect for me." ;
    sched:pain 0 ;
    <http://www.w3.org/ns/ui#backgroundColor> "#dfd" .

sched:Impossible a owl:Class ;
    rdfs:label "impossible" ;
    rdfs:comment "I really cannot do this." ;
    sched:pain 4 ;
    <http://www.w3.org/ns/ui#backgroundColor> "#fdd" .

sched:Painful a owl:Class ;
    rdfs:label "painfull" ;
    rdfs:comment "This would cause acute disruption" ;
    sched:pain 3 ;
    <http://www.w3.org/ns/ui#backgroundColor> "#fee" .

sched:Tolerable a owl:Class ;
    rdfs:label "tolerable" ;
    rdfs:comment "I can do this, not ideal." ;
    sched:pain 1 ;
    <http://www.w3.org/ns/ui#backgroundColor> "#efe" .

sched:YesNo a owl:Class ;
    rdfs:label "Yes or No" ;
    rdfs:comment "Provides users of a poll with the simplest choice." .

sched:YesNoMaybe a owl:Class ;
    rdfs:label "Yes, No or Maybe" ;
    rdfs:comment "Provides users of a poll with a little uncertainty." .

#################################################################
### Annotation properties
#################################################################

dcterms:description a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:rights a owl:AnnotationProperty .

dcterms:source a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

rdfs:comment a owl:AnnotationProperty .

rdfs:isDefinedBy a owl:AnnotationProperty .

rdfs:label a owl:AnnotationProperty .

rdfs:seeAlso a owl:AnnotationProperty .

sched:availabilityOptions a owl:AnnotationProperty .

sched:availibility a owl:AnnotationProperty ;
    rdfs:label "availability" .

sched:option a owl:AnnotationProperty ;
    rdfs:label "possible time for event" .

sched:pain a owl:AnnotationProperty .

sched:response a owl:AnnotationProperty ;
    rdfs:label "response" .

prov:wasDerivedFrom a owl:AnnotationProperty .

<http://www.w3.org/ns/ui#backgroundColor> a owl:AnnotationProperty .

#################################################################
### Individuals
#################################################################

sched:Maybe a owl:NamedIndividual ;
    rdfs:label "maybe" ;
    <http://www.w3.org/ns/ui#backgroundColor> "#ffe" .

sched:No a owl:NamedIndividual ;
    rdfs:label "no" ;
    <http://www.w3.org/ns/ui#backgroundColor> "#fee" .

sched:Painfull a owl:NamedIndividual .

sched:Yes a owl:NamedIndividual ;
    rdfs:label "yes" ;
    <http://www.w3.org/ns/ui#backgroundColor> "#efe" .
