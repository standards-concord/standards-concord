# Concord sample copy for trying Concord: Workflow and issue tracking
# Source: http://www.w3.org/2005/01/wf/flow
# Publisher: W3C / Tim Berners-Lee; upstream copy maintained by SolidOS
# Licence: W3C Software and Document License <https://www.w3.org/copyright/software-license-2023/>
# Upstream copy: upstream/wf.ttl (see upstream/SOURCES.md)
# Changes: Added an ontology header, explicit OWL declarations and declarations for referenced terms. Kept term IRIs, namespaces, labels and comments. Unconstrained or mixed-use properties are annotations; class and property metadata has no metamodel domain or range. Removed reserved RDF/RDFS metamodel constraints. Unsupported datatype ranges are widened to rdfs:Literal; annotation dates keep their lexical values as strings. Expanded legacy N3 bare names in the original namespace. Removed label-only anonymous inverse properties, which do not identify an OWL inverse.

@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix wf: <http://www.w3.org/2005/01/wf/flow#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
### Ontology
#################################################################

<http://www.w3.org/2005/01/wf/flow> a owl:Ontology ;
    dcterms:title "Workflow and issue tracking"@en ;
    dcterms:description "Tasks, issues, assignments and the states a piece of work moves through."@en ;
    rdfs:comment "Concord sample copy for trying Concord. Added an ontology header, explicit OWL declarations and declarations for referenced terms. Kept term IRIs, namespaces, labels and comments. Unconstrained or mixed-use properties are annotations; class and property metadata has no metamodel domain or range. Removed reserved RDF/RDFS metamodel constraints. Unsupported datatype ranges are widened to rdfs:Literal; annotation dates keep their lexical values as strings. Expanded legacy N3 bare names in the original namespace. Removed label-only anonymous inverse properties, which do not identify an OWL inverse."@en ,
        """This ontology defines a very general class (Task)
    which can used for any kind of bug tracking, issue tracking,
    to-do-list management, action items, goal dependency, and so on.
    It captures the state of a task as a subclass, so that
    subsumption can be used.
    It captures a discussion thread about a task.
    It captures subtasks structure if necessary.
    A \"Tracker\" defines actual set of states, categories, etc.,
    which  a task can be in. The data about the tracker
    guides the software managing the task.

    There is some workflow modeling finite state machine
    terms which are optional for  more complex definition
    of the transitions allowed.
    """ ;
    dcterms:source <http://www.w3.org/2005/01/wf/flow> ;
    dc:title "Issue Tracking Ontology" ;
    dcterms:creator <http://www.w3.org/People/Berners-Lee/card#i> ;
    dcterms:license <https://www.w3.org/copyright/software-license-2023/> ;
    dcterms:rights "Original vocabulary published by W3C / Tim Berners-Lee; upstream copy maintained by SolidOS." ;
    vann:preferredNamespacePrefix "wf" ;
    vann:preferredNamespaceUri wf: ;
    prov:wasDerivedFrom <http://www.w3.org/2005/01/wf/flow> .

#################################################################
### Classes
#################################################################

<http://www.w3.org/2000/10/swap/pim/doc#Document> a owl:Class .

<http://www.w3.org/2000/10/swap/pim/doc#Work> a owl:Class .

wf:ActionItem a owl:Class ;
    rdfs:label "action item"@en ;
    rdfs:comment """An obligation taken on by a person, typically at a meeting.
    """ ;
    rdfs:subClassOf wf:Task ;
    owl:disjointUnionOf ( wf:Open wf:Closed ) .

wf:Change a owl:Class ;
    rdfs:label "change" ;
    rdfs:comment """The universal class of things which
change the state of a task.
Included now: Creation, Transition. (Maybe in the future
more π-calculus constructions such as splitting & merging tasks,
and import/export of obligations to a foreign opaque system.)
""" .

wf:Closed a owl:Class ;
    rdfs:label "closed"@en , "fermé"@fr ;
    rdfs:comment """A task which does not need attention. It may be closed because
        has been abandoned or completed, for example.
    """ ;
    rdfs:subClassOf wf:Task ;
    <http://www.w3.org/ns/ui#backgroundColor> "#f5d6d6" .

wf:Creation a owl:Class ;
    rdfs:label "creation" ;
    rdfs:comment """A creation is a change from existence
to non-existence
a task. Typical properties include date and/or source
(a document causing the transition), and a final state.""" ;
    rdfs:subClassOf wf:Change .

wf:DateTime a owl:Class ;
    rdfs:label "DateTime"@en .

wf:Message a owl:Class ;
    rdfs:label "message"@en .

wf:NonTerminalState a owl:Class ;
    rdfs:label "non-terminal state" ;
    rdfs:comment "A state from which there are transitions." ;
    owl:disjointWith wf:TerminalState .

wf:Open a owl:Class ;
    rdfs:label "open"@en , "ouvert"@fr ;
    rdfs:comment """A task which needs attention. The very crude states of Open and Closed all
        interoperability between different systems if the states for a given
        application are made subclasses of either Open or Closed. This allows
        tasks from different systems to be mixed and treated together with
        limited but valuable functionality.
    """ ;
    rdfs:subClassOf wf:Task ;
    <http://www.w3.org/ns/ui#backgroundColor> "#d6f5d6" .

wf:Product a owl:Class ;
    rdfs:label "product" ;
    rdfs:comment """A product is a task which monitors something
                which must be produced.""" ;
    rdfs:subClassOf wf:Task .

wf:State a owl:Class ;
    rdfs:label "State"@en .

wf:Task a owl:Class ;
    rdfs:label "task"@en ;
    rdfs:comment """Something to be done in a wide sense,
    an agenda item at a meeting is one example, but any
    issue, task, action item, goal, product, deliverable, milestone, can such a thing.
    The requirement for this framework was that it would allow
    one to customize ontologies for things such as agenda items,
    action items, working group issues with a spec, w3c Last Call issues,
    software bugs and administrative requests.
    In π-calculus, a process.
    Make your type of issue a subclass of Task.
    """ ;
    owl:disjointUnionOf ( wf:Open wf:Closed ) .

wf:TerminalState a owl:Class ;
    rdfs:label "terminal state" ;
    rdfs:comment "A state from which there are no transitions." ;
    rdfs:subClassOf wf:State .

wf:Tracker a owl:Class ;
    rdfs:label "tracker" ;
    rdfs:comment """A set of issues and
                the constraints on how they evolve.
                To use this ontology, craete a new tracker.
                Copy an existing one or make up your own.""" .

wf:Transition a owl:Class ;
    rdfs:label "transition" ;
    rdfs:comment """A transition is a change of state of
a task. Typical properties include date and/or source
(a document causing the transition), and a final state.""" ;
    rdfs:subClassOf wf:Change .

foaf:Agent a owl:Class .

#################################################################
### Object properties
#################################################################

wf:affects a owl:ObjectProperty ;
    rdfs:label "affects" ;
    rdfs:domain <http://www.w3.org/2000/10/swap/pim/doc#Work> ;
    rdfs:range wf:Task .

wf:assignee a owl:ObjectProperty ;
    rdfs:label "assigned to" ;
    rdfs:comment "The person or group to whom this has been assigned." ;
    rdfs:range foaf:Agent .

wf:creates a owl:ObjectProperty ;
    rdfs:label "creates" ;
    rdfs:domain <http://www.w3.org/2000/10/swap/pim/doc#Work> ;
    rdfs:range wf:Task .

wf:date a owl:ObjectProperty ;
    rdfs:label "date"@en ;
    rdfs:range wf:DateTime .

wf:deliverable a owl:ObjectProperty ;
    rdfs:label "deliverable"@en ;
    rdfs:comment "Something which must be delivered to accomplish this" ;
    rdfs:subPropertyOf wf:dependent ;
    rdfs:range wf:Product .

wf:dependent a owl:ObjectProperty ;
    rdfs:label "how" ;
    rdfs:comment """Another task upon which this depends, in the sense that
        this task cannot be completed without that task being done.
        You can't use this for dependencies on anything other than other tasks.
        (Note the US spelling of the URI. In the UK, a dependant is a something
        which is dependent on somehing else.)""" ;
    rdfs:domain wf:Task ;
    rdfs:range wf:Task .

wf:final a owl:ObjectProperty ;
    rdfs:label "to" ;
    rdfs:domain wf:Transition ;
    rdfs:range wf:State .

wf:initialState a owl:ObjectProperty ;
    rdfs:label "état initial"@fr , "initial state"@en ;
    rdfs:comment "The initial state for a new issue" ;
    rdfs:domain wf:Tracker ;
    rdfs:range wf:State .

wf:modifiedBy a owl:ObjectProperty ;
    rdfs:label "changed by" ;
    rdfs:range foaf:Agent .

wf:recipent a owl:ObjectProperty ;
    rdfs:label "to" ;
    rdfs:domain wf:Message ;
    rdfs:range foaf:Agent .

wf:sender a owl:ObjectProperty ;
    rdfs:label "from" ;
    rdfs:domain wf:Message ;
    rdfs:range foaf:Agent .

wf:source a owl:ObjectProperty ;
    rdfs:label "source" ;
    rdfs:comment """The source of a transition is
                the document by which it happened""" ;
    rdfs:range <http://www.w3.org/2000/10/swap/pim/doc#Work> .

wf:stateStore a owl:ObjectProperty ;
    rdfs:label "state store" ;
    rdfs:comment """A read-write document.
                The state of the issues is modified here.
                When you set up a trcaker, thgis must be set to point
                to a writeble data resource on the web.""" ;
    rdfs:domain wf:Tracker ;
    rdfs:range <http://www.w3.org/2000/10/swap/pim/doc#Document> .

wf:subscriber a owl:ObjectProperty ;
    rdfs:label "subscriber" ;
    rdfs:range foaf:Agent .

wf:task a owl:ObjectProperty ;
    rdfs:label "task" ;
    rdfs:range wf:Task .

wf:tracker a owl:ObjectProperty ;
    rdfs:label "tracker" ;
    rdfs:domain wf:Task ;
    rdfs:range wf:Tracker .

wf:transactionStore a owl:ObjectProperty ;
    rdfs:label "transaction store" ;
    rdfs:comment """An appendable document. Transactions and messsages
                    can be written into here""" ;
    rdfs:domain wf:Tracker ;
    rdfs:range <http://www.w3.org/2000/10/swap/pim/doc#Document> .

#################################################################
### Datatype properties
#################################################################

wf:dateDue a owl:DatatypeProperty ;
    rdfs:label "due"@en ;
    rdfs:comment """The date this task is due.
                """ ;
    rdfs:domain wf:Task ;
    rdfs:range rdfs:Literal .

wf:goalDescription a owl:DatatypeProperty ;
    rdfs:label "goals" ;
    rdfs:comment "A textual description of the goals of this product, etc." ;
    rdfs:domain wf:Task ;
    rdfs:range xsd:string .

wf:successCriteria a owl:DatatypeProperty ;
    rdfs:label "success criteria" ;
    rdfs:comment """A textual description of the successs critera.
                How when we know this is done?""" ;
    rdfs:domain wf:Task ;
    rdfs:range xsd:string .

#################################################################
### Annotation properties
#################################################################

dc:title a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:rights a owl:AnnotationProperty .

dcterms:source a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

<http://usefulinc.com/ns/doap#bug-database> a owl:AnnotationProperty .

rdfs:comment a owl:AnnotationProperty .

rdfs:isDefinedBy a owl:AnnotationProperty .

rdfs:label a owl:AnnotationProperty .

rdfs:seeAlso a owl:AnnotationProperty .

wf:allowedTransitions a owl:AnnotationProperty ;
    rdfs:label "allowed transitions" ;
    rdfs:comment """The state machine is defined
    by these lists of transition allowed for each issue.
    (An interesting option in the Web is to make an allowed transition
    to a state in soemone else's ontology, which in turn allows
    transitions into many ontologies.  So a finite state maxchine
    may become very large. In practice this means that a task handed
    off to another organization may be processed on all kinds of ways.)""" .

wf:asigneeClass a owl:AnnotationProperty ;
    rdfs:label "assignees must be" ;
    rdfs:comment "When an issue is assigned, the assignee must be from this class" .

wf:attachment a owl:AnnotationProperty ;
    rdfs:label "attachment" ;
    rdfs:comment "Something related is attached for information." .

wf:description a owl:AnnotationProperty ;
    rdfs:label "description" ;
    rdfs:comment """The description, definition,
        or abstract. Information explaining what this is.
        Not arbitrary comment about anything, only about the subject.
        (Use this property for anything. There is no domain restriction.).""" .

wf:issue a owl:AnnotationProperty ;
    rdfs:label "issue" ;
    rdfs:comment "A transition changes the state of the given issue." .

wf:issueCategory a owl:AnnotationProperty ;
    rdfs:label "issue category" ;
    rdfs:comment """Issues may be categorized according to the
                subclasses of this class""" .

wf:issueClass a owl:AnnotationProperty ;
    rdfs:label "all issues must be in" ;
    rdfs:comment """The class of issues which are allowed in this tracker.
                This is essemtial to the operation of the tracker,
                as it defines which states an issue can be in.
                (The issueClass must be a disjointUnionOf the state classes)""" .

wf:message a owl:AnnotationProperty ;
    rdfs:label "message"@en ;
    rdfs:comment "A message about this. Attached for information." .

wf:requires a owl:AnnotationProperty ;
    rdfs:label "requires" ;
    rdfs:comment """To be a valid transition,
        a necessary (but not necessarily sufficuent) condition
        is that there be recorded these properties for the record""" .

wf:screenShot a owl:AnnotationProperty ;
    rdfs:label "screen shot"@en ;
    rdfs:comment """An image taken by capturing the state of a
                 computer screen, for example to demonstrate a problem""" .

wf:terminalOutput a owl:AnnotationProperty ;
    rdfs:label "terminal output"@en ;
    rdfs:comment """A file showing user interaction from a
                text terminal or console etc. """ .

wf:testData a owl:AnnotationProperty ;
    rdfs:label "test data"@en ;
    rdfs:comment """A file which can be used as inpiut to a test
                or to demonstrate a problem. """ .

prov:wasDerivedFrom a owl:AnnotationProperty .

<http://www.w3.org/ns/ui#backgroundColor> a owl:AnnotationProperty .
