@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix vol: <https://w3id.org/odi/volunteering#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
### Ontology
#################################################################

<https://w3id.org/odi/volunteering> a owl:Ontology ;
    owl:versionIRI <https://w3id.org/odi/volunteering/0.1.0> ;
    owl:versionInfo "0.1.0" ;
    dcterms:title "Volunteering Ontology"@en ;
    dcterms:description "An OWL ontology for describing volunteering opportunities, the organisations that offer them, the roles, skills, sessions and locations involved, and applications made by volunteers. It is a seed for a UK volunteering data standard."@en ;
    dcterms:created "2026-10-14"^^xsd:date ;
    dcterms:bibliographicCitation "Concord volunteering working group. Volunteering Ontology. Version 0.1.0. https://w3id.org/odi/volunteering" ;
    dcterms:creator "Concord volunteering working group" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-14"^^xsd:date ;
    dcterms:publisher <https://theodi.org/> ;
    vann:preferredNamespacePrefix "vol" ;
    vann:preferredNamespaceUri "https://w3id.org/odi/volunteering#"^^xsd:anyURI ;
    dcat:keyword "charity"@en ,
        "civil society"@en ,
        "open standards"@en ,
        "volunteering"@en .

#################################################################
### Classes
#################################################################

vol:AccessibilityFeature a owl:Class ;
    rdfs:label "accessibility feature"@en ;
    skos:altLabel "accessibility provision"@en ;
    skos:definition "A characteristic of a volunteering opportunity that affects whether people with particular access needs can take part, such as step-free access or a British Sign Language interpreter."@en ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:Agent a owl:Class ;
    rdfs:label "agent"@en ;
    skos:definition "An entity that can act, bear responsibility for its actions and take part in volunteering, either as an individual or as a group."@en ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:Application a owl:Class ;
    rdfs:label "application"@en ;
    skos:definition "A request, made by a person, to take up a role in a particular volunteering opportunity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vol:submittedBy ;
            owl:onClass vol:Person ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
            owl:onProperty vol:forOpportunity ;
            owl:onClass vol:VolunteeringOpportunity ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:Cause a owl:Class ;
    rdfs:label "cause"@en ;
    skos:definition "A social, environmental, cultural or other purpose that a volunteering opportunity is intended to advance."@en ;
    skos:example "Environment and conservation; health and social care; arts and heritage."@en ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:Location a owl:Class ;
    rdfs:label "location"@en ;
    skos:definition "A place, physical or virtual, where volunteering activities take place."@en ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:OnlineLocation a owl:Class ;
    rdfs:label "online location"@en ;
    skos:altLabel "remote"@en ;
    skos:definition "A location that is a virtual space, reached over the internet, where volunteering is done remotely."@en ;
    rdfs:subClassOf vol:Location ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:Organisation a owl:Class ;
    rdfs:label "organisation"@en ;
    skos:altLabel "organization"@en ;
    skos:definition "An agent that is a formally or informally constituted group of people with a shared purpose, such as a charity, community group, social enterprise or public body."@en ;
    rdfs:subClassOf vol:Agent ;
    owl:disjointWith vol:Person ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:Person a owl:Class ;
    rdfs:label "person"@en ;
    skos:definition "An agent that is an individual human being."@en ;
    rdfs:subClassOf vol:Agent ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:PhysicalLocation a owl:Class ;
    rdfs:label "physical location"@en ;
    skos:definition "A location that is a geographic place, identified by a postal address or coordinates."@en ;
    rdfs:subClassOf vol:Location ;
    owl:disjointWith vol:OnlineLocation ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:Role a owl:Class ;
    rdfs:label "volunteer role"@en ;
    skos:definition "A set of responsibilities and tasks that a volunteer is expected to carry out as part of a volunteering opportunity."@en ;
    skos:example "Befriender, event steward, trustee."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vol:hasTimeCommitment ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass vol:TimeCommitment ] ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:Session a owl:Class ;
    rdfs:label "session"@en ;
    skos:altLabel "shift"@en ;
    skos:definition "A scheduled occurrence of a volunteering opportunity, at a particular date and time, during which volunteers carry out their roles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vol:startDateTime ;
            owl:someValuesFrom xsd:dateTime ] ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:Skill a owl:Class ;
    rdfs:label "skill"@en ;
    skos:definition "A learned capability, such as first aid or bookkeeping, that a person can apply to a task."@en ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:TimeCommitment a owl:Class ;
    rdfs:label "time commitment"@en ;
    skos:definition "A description of the amount and pattern of time a volunteer is expected to give to a role, such as two hours a week or a one-off day."@en ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:Volunteer a owl:Class ;
    rdfs:label "volunteer"@en ;
    skos:definition "A person who gives their time, unpaid, to benefit other people, the environment or a cause, usually through or on behalf of an organisation."@en ;
    dcterms:source "NCVO definition of formal volunteering" ;
    rdfs:subClassOf vol:Person ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:VolunteerInvolvingOrganisation a owl:Class ;
    rdfs:label "volunteer-involving organisation"@en ;
    skos:altLabel "VIO"@en ;
    skos:definition "An organisation that offers at least one volunteering opportunity."@en ;
    rdfs:subClassOf vol:Organisation ,
        [ a owl:Restriction ;
            owl:onProperty vol:offersOpportunity ;
            owl:someValuesFrom vol:VolunteeringOpportunity ] ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:VolunteeringOpportunity a owl:Class ;
    rdfs:label "volunteering opportunity"@en ;
    skos:altLabel "opportunity"@en ;
    skos:definition "An offer, made by an organisation, of one or more roles that people can apply to take up as volunteers."@en ;
    skos:example "Weekly befriending calls with older people, offered by a local charity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vol:hasRole ;
            owl:someValuesFrom vol:Role ] ,
        [ a owl:Restriction ;
            owl:onProperty vol:offeredBy ;
            owl:someValuesFrom vol:Organisation ] ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

#################################################################
### Object properties
#################################################################

vol:forOpportunity a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "for opportunity"@en ;
    skos:definition "Relates an application to the volunteering opportunity that it is made for."@en ;
    rdfs:domain vol:Application ;
    rdfs:range vol:VolunteeringOpportunity ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:hasAccessibilityFeature a owl:ObjectProperty ;
    rdfs:label "has accessibility feature"@en ;
    skos:definition "Relates a volunteering opportunity to an accessibility feature that it provides."@en ;
    rdfs:domain vol:VolunteeringOpportunity ;
    rdfs:range vol:AccessibilityFeature ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:hasLocation a owl:ObjectProperty ;
    rdfs:label "has location"@en ;
    skos:definition "Relates a volunteering opportunity or session to a location where it takes place."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( vol:VolunteeringOpportunity vol:Session ) ] ;
    rdfs:range vol:Location ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:hasRole a owl:ObjectProperty ;
    rdfs:label "has role"@en ;
    skos:definition "Relates a volunteering opportunity to a role that volunteers can take up in it."@en ;
    rdfs:domain vol:VolunteeringOpportunity ;
    rdfs:range vol:Role ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:hasSession a owl:ObjectProperty ;
    rdfs:label "has session"@en ;
    skos:definition "Relates a volunteering opportunity to a scheduled session of it."@en ;
    rdfs:domain vol:VolunteeringOpportunity ;
    rdfs:range vol:Session ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:hasSkill a owl:ObjectProperty ;
    rdfs:label "has skill"@en ;
    skos:definition "Relates a person to a skill that they have."@en ;
    rdfs:domain vol:Person ;
    rdfs:range vol:Skill ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:hasTimeCommitment a owl:ObjectProperty ;
    rdfs:label "has time commitment"@en ;
    skos:definition "Relates a role to the time commitment expected of volunteers who take it up."@en ;
    rdfs:domain vol:Role ;
    rdfs:range vol:TimeCommitment ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:offeredBy a owl:ObjectProperty ;
    rdfs:label "offered by"@en ;
    skos:definition "Relates a volunteering opportunity to the organisation that offers it and is responsible for it."@en ;
    owl:inverseOf vol:offersOpportunity ;
    rdfs:domain vol:VolunteeringOpportunity ;
    rdfs:range vol:Organisation ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:offersOpportunity a owl:ObjectProperty ;
    rdfs:label "offers opportunity"@en ;
    skos:definition "Relates an organisation to a volunteering opportunity that it offers."@en ;
    rdfs:domain vol:Organisation ;
    rdfs:range vol:VolunteeringOpportunity ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:requiresSkill a owl:ObjectProperty ;
    rdfs:label "requires skill"@en ;
    skos:definition "Relates a role to a skill that a volunteer needs in order to carry it out."@en ;
    rdfs:domain vol:Role ;
    rdfs:range vol:Skill ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:submittedBy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "submitted by"@en ;
    skos:definition "Relates an application to the person who made it."@en ;
    rdfs:domain vol:Application ;
    rdfs:range vol:Person ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:supportsCause a owl:ObjectProperty ;
    rdfs:label "supports cause"@en ;
    skos:definition "Relates a volunteering opportunity to a cause that it is intended to advance."@en ;
    rdfs:domain vol:VolunteeringOpportunity ;
    rdfs:range vol:Cause ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

#################################################################
### Datatype properties
#################################################################

vol:charityNumber a owl:DatatypeProperty ;
    rdfs:label "charity number"@en ;
    skos:definition "The number under which an organisation is registered with a charity regulator, such as the Charity Commission for England and Wales."@en ;
    rdfs:domain vol:Organisation ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:endDateTime a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "end date and time"@en ;
    skos:definition "The date and time at which a session ends."@en ;
    rdfs:domain vol:Session ;
    rdfs:range xsd:dateTime ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:hoursPerWeek a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hours per week"@en ;
    skos:definition "The average number of hours each week that a time commitment involves."@en ;
    rdfs:domain vol:TimeCommitment ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:joiningUrl a owl:DatatypeProperty ;
    rdfs:label "joining URL"@en ;
    skos:definition "The web address that volunteers use to join an online location, such as a video call link."@en ;
    rdfs:domain vol:OnlineLocation ;
    rdfs:range xsd:anyURI ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:minimumAge a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "minimum age"@en ;
    skos:definition "The minimum age, in whole years, that a person must be to take up a volunteering opportunity."@en ;
    rdfs:domain vol:VolunteeringOpportunity ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:placesAvailable a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "places available"@en ;
    skos:definition "The number of volunteers that can still be accepted for a session."@en ;
    rdfs:domain vol:Session ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:postcode a owl:DatatypeProperty ;
    rdfs:label "postcode"@en ;
    skos:definition "The postal code of a physical location."@en ;
    rdfs:domain vol:PhysicalLocation ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:requiresBackgroundCheck a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requires background check"@en ;
    skos:definition "Whether a role requires a criminal record check, such as a Disclosure and Barring Service (DBS) check in England and Wales, before a volunteer can start."@en ;
    rdfs:domain vol:Role ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:startDateTime a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "start date and time"@en ;
    skos:definition "The date and time at which a session starts."@en ;
    rdfs:domain vol:Session ;
    rdfs:range xsd:dateTime ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:submittedAt a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "submitted at"@en ;
    skos:definition "The date and time at which an application was submitted."@en ;
    rdfs:domain vol:Application ;
    rdfs:range xsd:dateTime ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:summary a owl:DatatypeProperty ;
    rdfs:label "summary"@en ;
    skos:definition "A free-text description of a volunteering opportunity, written for prospective volunteers."@en ;
    rdfs:domain vol:VolunteeringOpportunity ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

vol:title a owl:DatatypeProperty ;
    rdfs:label "title"@en ;
    skos:definition "A short, human-readable name for a volunteering opportunity, as shown in listings."@en ;
    rdfs:domain vol:VolunteeringOpportunity ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/odi/volunteering> .

#################################################################
### Annotation properties
#################################################################

dcterms:bibliographicCitation a owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:publisher a owl:AnnotationProperty .

dcterms:source a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

skos:altLabel a owl:AnnotationProperty .

skos:definition a owl:AnnotationProperty .

skos:example a owl:AnnotationProperty .

dcat:keyword a owl:AnnotationProperty .

#################################################################
### General axioms
#################################################################

[ a owl:AllDisjointClasses ;
    owl:members (
            vol:Agent
            vol:VolunteeringOpportunity
            vol:Role
            vol:Skill
            vol:Cause
            vol:Location
            vol:Session
            vol:Application
            vol:AccessibilityFeature
            vol:TimeCommitment
        ) ] .
